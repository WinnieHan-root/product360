# 生产环境变量模板：复制到 deploy/.env 后逐项改成真实值
#   cp deploy/.env.production.example deploy/.env && chmod 600 deploy/.env
# 注意：deploy/.env 不进镜像、不进 tar 包（.dockerignore / 打包脚本均已排除）。

# ---------- PostgreSQL（容器内） ----------
POSTGRES_USER=product360
POSTGRES_PASSWORD=请换成强密码_32位以上
POSTGRES_DB=product360

# ---------- API ----------
# JWT 签名密钥：openssl rand -hex 32
JWT_SECRET=请换成随机32字节十六进制
PORT=3000

# 允许跨源访问的来源（逗号分隔）。同源部署（Nginx 反代 /api）时浏览器不会跨源，
# 保留填写服务器地址即可；将来加域名时改成 https://your-domain.com
APP_ORIGIN=http://47.0.0.0

# ---------- 宿主机 ----------
# Nginx 对外端口，80 可省略
HTTP_PORT=80

# 样例 CSV 目录（默认镜像内 /app/docs/sample_exports，一般不用改）
# SAMPLE_EXPORT_DIR=/app/docs/sample_exports

# 构建期 npm 源（阿里云 ECS 建议用镜像源，构建快很多）
NPM_REGISTRY=https://registry.npmmirror.com

# 镜像 tag，发版时改成日期或 git sha，便于回滚
APP_VERSION=2026.10.27
